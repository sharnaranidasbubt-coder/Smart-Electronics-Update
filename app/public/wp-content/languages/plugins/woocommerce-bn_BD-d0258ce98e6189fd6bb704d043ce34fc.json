"\u09ae\u09c2\u09b2\u09cd\u09af \u09aa\u09b0\u09bf\u09b8\u09c0\u09ae\u09be"],"Auto":["\u09b8\u09cd\u09ac\u09df\u0982\u0995\u09cd\u09b0\u09bf\u09df"],"New Arrivals":["\u09a8\u09a4\u09c1\u09a8 \u098f\u09b8\u09c7\u099b\u09c7"],"On sale products":["\u099b\u09be\u09dc\u0995\u09c3\u09a4 \u09aa\u09a3\u09cd\u09af"],"New arrivals":["\u09a8\u09a4\u09c1\u09a8 \u098f\u09b8\u09c7\u099b\u09c7"],"Highlight products that are currently on sale.":["\u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8\u09c7 \u09a1\u09bf\u09b8\u0995\u09be\u0989\u09a8\u09cd\u099f \u099a\u09b2\u099b\u09c7 \u098f\u09ae\u09a8 \u09aa\u09a3\u09cd\u09af\u0997\u09c1\u09b2\u09c7\u09be \u09b9\u09be\u0987\u09b2\u09be\u0987\u099f \u0995\u09b0\u09c1\u09a8\u0964"],"Recommend your best-selling products.":["\u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09b0\u09cd\u09ac\u09be\u09a7\u09bf\u0995 \u09ac\u09bf\u0995\u09cd\u09b0\u09bf\u09a4 \u09aa\u09a3\u09cd\u09af\u0997\u09c1\u09b2\u09c7\u09be \u09b8\u09c1\u09aa\u09be\u09b0\u09bf\u09b6 \u0995\u09b0\u09c1\u09a8\u0964"],"Recommend products with the highest review ratings.":["\u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u09b0\u09bf\u09ad\u09bf\u0989 \u09b0\u09c7\u099f\u09bf\u0982 \u09b8\u09b9 \u09aa\u09a3\u09cd\u09af\u0997\u09c1\u09b2\u09c7\u09be \u09b8\u09c1\u09aa\u09be\u09b0\u09bf\u09b6 \u0995\u09b0\u09c1\u09a8\u0964"],"Recommend your newest products.":["\u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09a4\u09c1\u09a8 \u09aa\u09a3\u09cd\u09af\u0997\u09c1\u09b2\u09c7\u09be \u09b8\u09c1\u09aa\u09be\u09b0\u09bf\u09b6 \u0995\u09b0\u09c1\u09a8\u0964"],"Choose collection":["\u09b8\u0982\u0997\u09cd\u09b0\u09b9 \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a8"],"Showcase your featured products.":["\u0986\u09aa\u09a8\u09be\u09b0 \u09ab\u09bf\u099a\u09be\u09b0\u09a1 \u09aa\u09a3\u09cd\u09af\u0997\u09c1\u09b2\u09c7\u09be \u09a6\u09c7\u0996\u09be\u09a8\u0964"],"Responsive":["\u09b0\u09c7\u09b8\u09cd\u09aa\u09a8\u09cd\u09b8\u09bf\u09ad"],"Automatically adjust the number of columns to better fit smaller screens.":["\u099b\u09cb\u099f \u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8\u09c7 \u0986\u09b0\u0993 \u09ad\u09be\u09b2\u09cb\u09ad\u09be\u09ac\u09c7 \u09ab\u09bf\u099f \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09cd\u09ac\u09af\u09bc\u0982\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09ad\u09be\u09ac\u09c7 \u0995\u09b2\u09be\u09ae\u09c7\u09b0 \u09b8\u0982\u0996\u09cd\u09af\u09be \u09b8\u09be\u09ae\u099e\u09cd\u099c\u09b8\u09cd\u09af \u0995\u09b0\u09c1\u09a8\u0964"],"Product Collection query operator\u0004Before":["\u0986\u0997\u09c7"],"Product Collection query operator\u0004Within":["\u09ae\u09a7\u09cd\u09af\u09c7"],"Show only featured products":["\u0995\u09c7\u09ac\u09b2 \u09ab\u09bf\u099a\u09be\u09b0\u09a1 \u09aa\u09a3\u09cd\u09af \u09a6\u09c7\u0996\u09be\u09a8"],"Grid":["\u0997\u09cd\u09b0\u09bf\u09a1"],"Stack":["\u09b8\u09cd\u099f\u09cd\u09af\u09be\u0995"],"Display products in a single column.":["\u098f\u0995\u099f\u09bf \u098f\u0995\u0995 \u0995\u09b2\u09be\u09ae\u09c7 \u09aa\u09a3\u09cd\u09af \u09aa\u09cd\u09b0\u09a6\u09b0\u09cd\u09b6\u09a8 \u0995\u09b0\u09c1\u09a8\u0964"],"Display products using rows and columns.":["\u09b8\u09be\u09b0\u09bf \u098f\u09ac\u0982 \u0995\u09b2\u09be\u09ae \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7 \u09aa\u09a3\u09cd\u09af \u09aa\u09cd\u09b0\u09a6\u09b0\u09cd\u09b6\u09a8 \u0995\u09b0\u09c1\u09a8\u0964"],"Select a product":["\u09aa\u09a3\u09cd\u09af \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8"],"Offset":["\u0985\u09ab\u09b8\u09c7\u099f"],"Limit the pages you want to show, even if the query has more results. To show all pages use 0 (zero).":["\u0986\u09aa\u09a8\u09bf \u09af\u09c7 \u09aa\u09c3\u09b7\u09cd\u09a0\u09be\u0997\u09c1\u09b2\u09cb \u09aa\u09cd\u09b0\u09a6\u09b0\u09cd\u09b6\u09a8 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u09a8; \u09a4\u09be \u09b8\u09c0\u09ae\u09be\u09ac\u09a6\u09cd\u09a7 \u0995\u09b0\u09c1\u09a8\u0964 \u09af\u09a6\u09bf\u0993, \u0995\u09cb\u09af\u09bc\u09c7\u09b0\u0