u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u0995\u09b0\u09c1\u09a8..."],"Rating, low to high":["\u09b0\u09c7\u099f\u09bf\u0982, \u0995\u09ae \u09a5\u09c7\u0995\u09c7 \u09ac\u09c7\u09b6\u09bf"],"Rating, high to low":["\u09b0\u09c7\u099f\u09bf\u0982, \u09ac\u09c7\u09b6\u09bf \u09a5\u09c7\u0995\u09c7 \u0995\u09ae"],"Sales, low to high":["\u09ac\u09bf\u0995\u09cd\u09b0\u09bf, \u0995\u09ae \u09a5\u09c7\u0995\u09c7 \u09ac\u09c7\u09b6\u09bf"],"Sales, high to low":["\u09ac\u09bf\u0995\u09cd\u09b0\u09bf, \u09ac\u09c7\u09b6\u09bf \u09a5\u09c7\u0995\u09c7 \u0995\u09ae"],"Price, low to high":["\u09a6\u09be\u09ae, \u0995\u09ae \u09a5\u09c7\u0995\u09c7 \u09ac\u09c7\u09b6\u09bf"],"Price, high to low":["\u09a6\u09be\u09ae, \u09ac\u09c7\u09b6\u09bf \u09a5\u09c7\u0995\u09c7 \u0995\u09ae"],"Show products based on specific criteria and allow shoppers to filter.":["\u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u09ae\u09be\u09a8\u09a6\u09a3\u09cd\u09a1\u09c7\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u09a4\u09c7 \u09aa\u09a3\u09cd\u09af \u09a6\u09c7\u0996\u09be\u09a8 \u098f\u09ac\u0982 \u0995\u09cd\u09b0\u09c7\u09a4\u09be\u0995\u09c7 \u09ab\u09bf\u09b2\u09cd\u099f\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a6\u09bf\u09a8\u0964"],"Related by":["\u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09bf\u09a4"],"From a specific product":["\u098f\u0995\u099f\u09bf \u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u09aa\u09a3\u09cd\u09af \u09a5\u09c7\u0995\u09c7"],"From the current product":["\u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u09aa\u09a3\u09cd\u09af \u09a5\u09c7\u0995\u09c7"],"From products in the order":["\u0995\u09cd\u09b0\u09ae\u09be\u09a8\u09c1\u09b8\u09be\u09b0\u09c7 \u09aa\u09a3\u09cd\u09af \u09a5\u09c7\u0995\u09c7"],"From products in the cart":["\u0995\u09be\u09b0\u09cd\u099f\u09c7 \u09a5\u09be\u0995\u09be \u09aa\u09a3\u09cd\u09af \u09a5\u09c7\u0995\u09c7"],"Select a product to pull the linked products from":["\u09b2\u09bf\u0999\u09cd\u0995 \u0995\u09b0\u09be \u09aa\u09a3\u09cd\u09af \u09b8\u0982\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0995\u099f\u09bf \u09aa\u09a3\u09cd\u09af \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8"],"Linked products will be pulled from the product a shopper is currently viewing":["\u0995\u09cd\u09b0\u09c7\u09a4\u09be \u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8\u09c7 \u09af\u09c7 \u09aa\u09a3\u09cd\u09af\u099f\u09bf \u09a6\u09c7\u0996\u099b\u09c7\u09a8 \u09b8\u09c7\u0996\u09be\u09a8 \u09a5\u09c7\u0995\u09c7 \u09b2\u09bf\u0999\u09cd\u0995 \u0995\u09b0\u09be \u09aa\u09a3\u09cd\u09af \u09b8\u09b0\u09bf\u09af\u09bc\u09c7 \u09a8\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09ac\u09c7\u0964"],"Hand-Picked":["\u09b9\u09be\u09a4\u09c7-\u09a4\u09c7\u09be\u09b2\u09be"],"Show a list of products based on fixed criteria.":["\u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u09ae\u09be\u09a8\u09a6\u09a3\u09cd\u09a1\u09c7\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u09a4\u09c7 \u09aa\u09a3\u09cd\u09af\u09c7\u09b0 \u098f\u0995\u099f\u09bf \u09b2\u09bf\u09b8\u09cd\u099f \u09a6\u09c7\u0996\u09be\u09a8\u0964"],"Related Products":["\u098f\u0995\u0987 \u09a7\u09b0\u09a8\u09c7\u09b0 \u09aa\u09a3\u09cd\u09af\u09b8\u09ae\u09c2\u09b9\u0964"],"You may also like":["\u0986\u09aa\u09a8\u09bf \u098f\u099f\u09be\u0993 \u09aa\u099b\u09a8\u09cd\u09a6 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8"],"Display products based on the current template and allow shoppers to filter.":["\u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u099f\u09c7\u09ae\u09aa\u09cd\u09b2\u09c7\u099f\u09c7\u09b0 \u0989\u09aa\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf \u0995\u09b0\u09c7 \u09aa\u09a3\u09cd\u09af \u09aa\u09cd\u09b0\u09a6\u09b0\u09cd\u09b6\u09a8 \u0995\u09b0\u09c1\u09a8 \u098f\u09ac\u0982 \u0995\u09cd\u09b0\u09c7\u09a4\u09be\u0995\u09c7 \u09ab\u09bf\u09b2\u09cd\u099f\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a6\u09bf\u09a8\u0964"],"Upsells are typically products that are extra profitable or better quality or more expensive. Experiment with combinations to boost sales.":["\u0986\u09aa\u09b8\u09c7\u09b2 \u09b9\u09b2 \u09b8\u09be\u09a7\u09be\u09b0\u09a3\u09a4 \u098f\u09ae\u09a8 \u09aa\u09a3\u09cd\u09af \u09af\u09be \u0985\u09a4\u09bf\u09b0\u09bf\u0995\u09cd\u09a4 \u09b2\u09be\u09ad\u099c\u09a8\u0995, \u0989\u09a8\u09cd\u09a8\u09a4 \u09ae\u09be\u09a8\u09c7\u09b0 \u09ac\u09be \u09ac\u09c7\u09b6\u09bf \u09ac\u09cd\u09af\u09af\u09bc\u09ac\u09b9\u09c1\u09b2\u0964 \u09ac\u09bf\u0995\u09cd\u09b0\u09af\u09bc \u09ac\u09be\u09a1\u09bc\u09be\u09a8\u09cb\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u0982\u09ae\u09bf\u09b6\u09cd\u09b0\u09a3 \u09a8\u09bf\u09af\u09bc\u09c7 \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be-\u09a8\u09bf\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8\u0964"],"Recommend products like this one.":["\u098f\u0987 \u09a7\u09b0\u09a8\u09c7\u09b0 \u09aa\u09a3\u09cd\u09af \u09b8\u09c1\u09aa\u09be\u09b0\u09bf\u09b6 \u0995\u09b0\u09c1\u09a8\u0964"],"Recommended products":["\u09b8\u09c1\u09aa\u09be\u09b0\u09bf\u09b6\u0995\u09c3\u09a4 \u09aa\u09a3\u09cd\u09af"],"Select specific products to recommend to customers.":["\u0997\u09cd\u09b0\u09be\u09b9\u0995\u09a6\u09c7\u09b0 \u09b8\u09c1\u09aa\u09be\u09b0\u09bf\u09b6 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u09aa\u09a3\u09cd\u09af \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\u0964"],"Cross-Sells":["\u0995\u09cd\u09b0\u09b8-\u09b8\u09c7\u09b2"],"By suggesting complementary products in the cart using cross-sells, you can significantly increase the average order value.":["\u0995\u09cd\u09b0\u09b8-\u09b8\u09c7\u09b2 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7 \u0995\u09be\u09b0\u09cd\u099f\u09c7 \u09aa\u09b0\u09bf\u09aa\u09c2\u09b0\u0995 \u09aa\u09a3\u09cd\u09af\u09c7\u09b0 \u09aa\u09b0\u09be\u09ae\u09b0\u09cd\u09b6 \u09a6\u09bf\u09af\u09bc\u09c7, \u0986\u09aa\u09a8\u09bf \u0997\u09a1\u09bc \u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u09ae\u09c2\u09b2\u09cd\u09af \u0989\u09b2\u09cd\u09b2\u09c7\u0996\u09af\u09cb\u0997\u09cd\u09af\u09ad\u09be\u09ac\u09c7 \u09ac\u09c3\u09a6\u09cd\u09a7\u09bf \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964"],"Featured Products":["\u09ab\u09bf\u099a\u09be\u09b0\u09a1 \u09aa\u09a3\u09cd\u09af"],"<strong>%s<\/strong> requires a product to be selected in order to display associated items.":["<strong>%s<\/strong> \u098f\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09bf\u09a4 \u0986\u0987\u099f\u09c7\u09ae\u0997\u09c1\u09b2\u09c7\u09be \u09aa\u09cd\u09b0\u09a6\u09b0\u09cd\u09b6\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0995\u099f\u09bf \u09aa\u09a3\u09cd\u09af \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09be \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964"],"Linked Product":["\u09b2\u09bf\u0999\u09cd\u0995\u09af\u09c1\u0995\u09cd\u09a4 \u09aa\u09a3\u09cd\u09af"],"Previously selected product is no longer available.":["\u09aa\u09c2\u09b0\u09cd\u09ac\u09c7 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09bf\u09a4 \u09aa\u09a3\u09cd\u09af\u099f\u09bf \u0986\u09b0 \u0989\u09aa\u09b2\u09ac\u09cd\u09a7 \u09a8\u09c7\u0987\u0964"],"Actual products will vary depending on the product being viewed.":["\u09a6\u09c7\u0996\u09be \u09aa\u09a3\u09cd\u09af\u09c7\u09b0 \u0989\u09aa\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ad\u09b0 \u0995\u09b0\u09c7 \u09aa\u09cd\u09b0\u0995\u09c3\u09a4 \u09aa\u09a3\u09cd\u09af\u0997\u09c1\u09b2\u09c7\u09be \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09bf\u09a4 \u09b9\u09ac\u09c7\u0964"],"create your own":["\u0986\u09aa\u09a8\u09be\u09b0\u099f\u09be \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c1\u09a8"],"or":["\u0985\u09a5\u09ac\u09be"],"What products do you want to show?":["\u0986\u09aa\u09a8\u09bf \u0995\u09c0 \u09a7\u09b0\u09a8\u09c7\u09b0 \u09aa\u09a3\u09cd\u09af \u09aa\u0