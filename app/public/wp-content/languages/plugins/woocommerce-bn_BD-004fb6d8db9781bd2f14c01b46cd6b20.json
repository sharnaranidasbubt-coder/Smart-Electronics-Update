\u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8 \u09ac\u09be \u09aa\u09b0\u09c7 \u09b8\u09cd\u099f\u09cb\u09b0 \u09b8\u09c7\u099f\u09bf\u0982\u09b8\u09c7 \u09b8\u0982\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\u0964"],"These details are required to receive payments via bank transfer":["\u09ac\u09cd\u09af\u09be\u0999\u09cd\u0995 \u099f\u09cd\u09b0\u09be\u09a8\u09cd\u09b8\u09ab\u09be\u09b0\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u09aa\u09be\u0993\u09af\u09bc\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0987 \u09ac\u09bf\u09ac\u09b0\u09a3\u0997\u09c1\u09b2\u09bf\u09b0 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8"],"Please enter an account number or IBAN":["\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u098f\u0995\u099f\u09bf \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09a8\u09ae\u09cd\u09ac\u09b0 \u09ac\u09be IBAN \u09b2\u09bf\u0996\u09c1\u09a8\u0964"],"Add your bank details":["\u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09cd\u09af\u09be\u0999\u09cd\u0995\u09c7\u09b0 \u09ac\u09bf\u09ac\u09b0\u09a3 \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8"],"Direct bank transfer details added successfully":["\u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u09ac\u09cd\u09af\u09be\u0999\u09cd\u0995 \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0\u09c7\u09b0 \u09ac\u09bf\u09ac\u09b0\u09a3 \u09b8\u09ab\u09b2\u09ad\u09be\u09ac\u09c7 \u09af\u09cb\u0997 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7"],"There was a problem saving your payment settings":["\u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3 \u0995\u09b0\u09a4\u09c7 \u098f\u0995\u099f\u09bf \u09b8\u09ae\u09b8\u09cd\u09af\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964"],"Install %s":["\u0987\u09a8\u09cd\u09b8\u099f\u09b2 %s"],"Get started":["\u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c1\u09a8"],"Task List Options":["\u099f\u09be\u09b8\u09cd\u0995 \u09b2\u09bf\u09b8\u09cd\u099f \u0985\u09aa\u09b6\u09a8"],"Good news!":["\u09b6\u09c1\u09ad \u09b8\u0982\u09ac\u09be\u09a6!"],"By clicking \"Configure\" you're enabling tax rates and calculations. More info {{link}}here{{\/link}}.":["\"\u0995\u09a8\u09ab\u09bf\u0997\u09be\u09b0\" \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09bf \u0995\u09b0\u09c7\u09b0 \u09b9\u09be\u09b0 \u098f\u09ac\u0982 \u0997\u09a3\u09a8\u09be \u09b8\u0995\u09cd\u09b7\u09ae \u0995\u09b0\u099b\u09c7\u09a8\u0964 \u0986\u09b0\u0993 \u09a4\u09a5\u09cd\u09af {{link}}\u098f\u0996\u09be\u09a8\u09c7{{\/link}} \u09aa\u09be\u09ac\u09c7\u09a8\u0964"],"Head over to the tax rate settings screen to configure your tax rates":["\u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09b0\u09c7\u09b0 \u09b9\u09be\u09b0 \u0995\u09a8\u09ab\u09bf\u0997\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u0995\u09b0\u09c7\u09b0 \u09b9\u09be\u09b0 \u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8\u09c7 \u09af\u09be\u09a8\u0964"],"Configure tax rates":["\u0995\u09b0\u09c7\u09b0 \u09b9\u09be\u09b0 \u0995\u09a8\u09ab\u09bf\u0997\u09be\u09b0 \u0995\u09b0\u09c1\u09a8"],"Connect your store to WordPress.com to enable automated sales tax calculations":["\u09b8\u09cd\u09ac\u09af\u09bc\u0982\u0995\u09cd\u09b0\u09bf\u09af\u09bc \u09ac\u09bf\u0995\u09cd\u09b0\u09af\u09bc \u0995\u09b0 \u0997\u09a3\u09a8\u09be \u09b8\u0995\u09cd\u09b7\u09ae \u0995\u09b0\u09a4\u09c7 WordPress.com-\u098f\u09b0 \u09b8\u09be\u09a5\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09cd\u099f\u09c7\u09be\u09b0 \u09b8\u0982\u09af\u09c1\u0995\u09cd\u09a4 \u0995\u09b0\u09c1\u09a8\u0964"],"Set up tax rates manually":["\u09ae\u09cd\u09af\u09be\u09a8\u09c1\u09af\u09bc\u09be\u09b2\u09bf \u0995\u09b0\u09c7\u09b0 \u09b9\u09be\u09b0 \u09b8\u09c7\u099f \u0986\u09aa \u0995\u09b0\u09c1\u09a8"],"WooCommerce Tax allows you to automate sales tax calculations":["WooCommerce \u099f\u09cd\u09af\u09be\u0995\u09cd\u09