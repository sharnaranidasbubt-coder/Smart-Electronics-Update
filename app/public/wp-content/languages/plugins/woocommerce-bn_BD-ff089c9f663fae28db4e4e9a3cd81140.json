89 \u0995\u09b0\u09c1\u09a8"],"\ud83d\ude80 You\u2019re doing great! {{strongText}}%1$d steps left{{\/strongText}} to get your store up and running. {{setupLink}}Continue setup{{\/setupLink}}":["\ud83d\ude80 \u0986\u09aa\u09a8\u09bf \u09a6\u09be\u09b0\u09c1\u09a3 \u0995\u09b0\u099b\u09c7\u09a8! \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09cd\u099f\u09c7\u09be\u09b0 \u099a\u09be\u09b2\u09c1 \u0995\u09b0\u09a4\u09c7 {{strongText}}%1$d\u099f\u09bf \u09a7\u09be\u09aa \u09ac\u09be\u0995\u09bf \u0986\u099b\u09c7{{\/strongText}}\u0964 {{setupLink}}\u09b8\u09c7\u099f\u0986\u09aa \u099a\u09be\u09b2\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8{{\/setupLink}}"],"\ud83c\udf89 Almost there. Only {{strongText}}%1$d step left{{\/strongText}} get your store up and running. {{setupLink}}Finish setup{{\/setupLink}}":["\ud83c\udf89 \u09aa\u09cd\u09b0\u09be\u09df \u09b9\u09df\u09c7 \u0997\u09c7\u099b\u09c7\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09cd\u099f\u09cb\u09b0 \u099a\u09be\u09b2\u09c1 \u0995\u09b0\u09a4\u09c7 \u0986\u09b0 \u09ae\u09be\u09a4\u09cd\u09b0 {{strongText}}%1$d\u099f\u09bf \u09a7\u09be\u09aa \u09ac\u09be\u0995\u09bf \u0986\u099b\u09c7{{\/strongText}}\u0964 {{setupLink}}\u09b8\u09c7\u099f\u0986\u09aa \u09b6\u09c7\u09b7 \u0995\u09b0\u09c1\u09a8{{\/setupLink}}"],"Activity":["\u0995\u09be\u09b0\u09cd\u09af\u0995\u09b2\u09be\u09aa"],"You have %d new thing to do":["\u0986\u09aa\u09a8\u09be\u09b0 %d\u099f\u09bf \u09a8\u09a4\u09c1\u09a8 \u0995\u09bf\u099b\u09c1 \u0995\u09b0\u09be\u09b0 \u0986\u099b\u09c7","\u0986\u09aa\u09a8\u09be\u09b0 %d\u099f\u09bf \u09a8\u09a4\u09c1\u09a8 \u0995\u09bf\u099b\u09c1 \u0995\u09b0\u09be\u09b0 \u0986\u099b\u09c7"],"You have inventory to review and update":["\u09aa\u09b0\u09cd\u09af\u09be\u09b2\u09cb\u099a\u09a8\u09be \u098f\u09ac\u0982 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09be\u099b\u09c7 \u09a4\u09be\u09b2\u09bf\u0995\u09be \u09b0\u09af\u09bc\u09c7\u099b\u09c7"],"Inventory to review":["\u09aa\u09b0\u09cd\u09af\u09be\u09b2\u09cb\u099a\u09a8\u09be \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0987\u09a8\u09ad\u09c7\u09a8\u09cd\u099f\u09b0\u09bf"],"Orders to fulfill":["\u09aa\u09b0\u09bf\u09aa\u09c2\u09b0\u09a3\u09af\u09c7\u09be\u0997\u09cd\u09af \u0985\u09b0\u09cd\u09a1\u09be\u09b0\u09b8\u09ae\u09c2\u09b9"],"Things to do next":["\u098f\u09b0\u09aa\u09b0 \u09af\u09be \u0995\u09b0\u09a4\u09c7 \u09b9\u09ac\u09c7"],"Preview site":["\u09b8\u09be\u0987\u099f\u09c7\u09b0 \u09aa\u09cd\u09b0\u09bf\u09ad\u09bf\u0989 \u09a6\u09c7\u0996\u09c1\u09a8"],"Two columns":["\u09a6\u09c1\u0987\u099f\u09bf \u0995\u09b2\u09be\u09ae"],"Single column":["\u098f\u0995 \u0995\u09b2\u09be\u09ae"],"Display options":["\u09aa\u09cd\u09b0\u09a6\u09b0\u09cd\u09b6\u09a8\u09c7\u09b0 \u09ac\u09bf\u0995\u09b2\u09cd\u09aa\u09b8\u09ae\u09c2\u09b9"],"The extension has been successfully activated.":["\u098f\u0995\u09cd\u09b8\u099f\u09c7\u09a8\u09b6\u09a8\u099f\u09bf \u09b8\u09ab\u09b2\u09ad\u09be\u09ac\u09c7 \u09b8\u0995\u09cd\u09b0\u09bf\u09af\u09bc \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964"],"There was an error trying to activate the extension.":["\u098f\u0995\u09cd\u09b8\u099f\u09c7\u09a8\u09b6\u09a8\u099f\u09bf \u09b8\u0995\u09cd\u09b0\u09bf\u09af\u09bc \u0995\u09b0\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09be\u09b0 \u09b8\u09ae\u09af\u09bc \u098f\u0995\u099f\u09bf \u09a4\u09cd\u09b0\u09c1\u099f\u09bf \u099b\u09bf\u09b2\u0964"],"There was an error loading recommended extensions.":["\u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09be\u09ac\u09bf\u09a4 \u098f\u0995\u09cd\u09b8\u099f\u09c7\u09a8\u09b6\u09a8 \u09b2\u09cb\u09a1 \u0995\u09b0\u09be\u09b0 \u09b8\u09ae\u09af\u09bc \u098f\u0995\u099f\u09bf \u09a4\u09cd\u09b0\u09c1\u099f\u09bf \u099b\u09bf\u09b2\u0964"],"There was an error loading installed extensions.":["\u0987\u09a8\u09b8\u09cd\u099f\u09b2 \u0995\u09b0\u09be \u098f\u0995\u09cd\u09b8\u099f\u09c7\u09a8\u09b6\u09a8\u09